{
  "name": "macsweep",
  "productName": "MacSweep",
  "version": "1.1.0",
  "description": "MacSweep - System Optimizer for macOS",
  "main": "dist-electron/main.js",
  "author": {
    "name": "Thiago Bruno Miranda",
    "email": "thiagobrunomiranda@gmail.com"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --mode web",
    "dist": "rm -rf dist dist-electron release && npm run build && electron-builder --mac"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "framer-motion": "^11.0.0",
    "globals": "^15.15.0",
    "i18next": "^25.8.4",
    "lucide-react": "^0.300.0",
    "prettier": "^3.9.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.5.4",
    "recharts": "^2.10.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.macsweep.app",
    "productName": "MacSweep",
    "icon": "assets/icon.png",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "icon.png",
          "trayTemplate*.png"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "darkModeSupport": true
    },
    "directories": {
      "output": "release"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
